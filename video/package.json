{
  "name": "tonesnap-video",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "audio": "node gen-audio.mjs",
    "render": "pnpm audio && remotion render ToneSnapIntro ../site/media/tonesnap-intro.mp4 --crf=24",
    "poster": "remotion still ToneSnapIntro ../site/media/tonesnap-intro-poster.jpg --frame=870 --scale=0.667 --image-format=jpeg --jpeg-quality=85",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.537",
    "@remotion/cli": "^4.0.537",
    "@remotion/renderer": "^4.0.537",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.537"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
